#: django_features/custom_fields/fields.py
msgid "This list may not be empty."
msgstr "Diese Liste darf nicht leer sein."

#: django_features/custom_fields/fields.py
#, python-format
msgid "Multiple custom values match '%(field)s': %(values)s. Choice lookup values must be unique within a custom field."
msgstr "Mehrere benutzerdefinierte Werte stimmen mit '%(field)s' überein: %(values)s. Auswahlwerte müssen innerhalb eines benutzerdefinierten Feldes eindeutig sein."

#: django_features/custom_fields/fields.py
#, python-format
msgid "Custom value with the %(field)s %(value)s does not exist."
msgstr "Der benutzerdefinierte Wert mit %(field)s %(value)s existiert nicht."

#: django_features/custom_fields/fields.py
#, python-format
msgid "Malformed custom choice. Expected a value or object containing '%(field)s'."
msgstr "Ungültige benutzerdefinierte Auswahl. Erwartet wurde ein Wert oder ein Objekt mit '%(field)s'."

#: django_features/custom_fields/fields.py
#, python-format
msgid "Malformed custom choice %(value)r for '%(field)s'."
msgstr "Ungültige benutzerdefinierte Auswahl %(value)r für '%(field)s'."

#: django_features/custom_fields/fields.py
#, python-format
msgid "Duplicate custom choice values are not allowed: %(values)s"
msgstr "Doppelte benutzerdefinierte Auswahlwerte sind nicht erlaubt: %(values)s"

#: django_features/custom_fields/fields.py
#, python-format
msgid "Some custom choices do not exist for '%(field)s': %(values)s"
msgstr "Einige benutzerdefinierte Auswahlwerte für '%(field)s' existieren nicht: %(values)s"

#: django_features/custom_fields/fields.py
#, python-format
msgid "The field %(field)s is not a choice field."
msgstr "Das Feld %(field)s ist kein Auswahlfeld."

#: django_features/custom_fields/fields.py
#, python-format
msgid "Expected a list of custom choices, but got %(value)r."
msgstr "Eine Liste benutzerdefinierter Auswahlwerte wurde erwartet, aber %(value)r erhalten."

