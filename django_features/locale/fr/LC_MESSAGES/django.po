#: django_features/custom_fields/fields.py
msgid "This list may not be empty."
msgstr "Cette liste ne peut pas être vide."

#: django_features/custom_fields/fields.py
#, python-format
msgid "Multiple custom values match '%(field)s': %(values)s. Choice lookup values must be unique within a custom field."
msgstr "Plusieurs valeurs personnalisées correspondent à « %(field)s » : %(values)s. Les valeurs de référence des choix doivent être uniques dans un champ personnalisé."

#: django_features/custom_fields/fields.py
#, python-format
msgid "Custom value with the %(field)s %(value)s does not exist."
msgstr "La valeur personnalisée avec %(field)s %(value)s n’existe pas."

#: django_features/custom_fields/fields.py
#, python-format
msgid "Malformed custom choice. Expected a value or object containing '%(field)s'."
msgstr "Choix personnalisé incorrect. Une valeur ou un objet contenant « %(field)s » était attendu."

#: django_features/custom_fields/fields.py
#, python-format
msgid "Malformed custom choice %(value)r for '%(field)s'."
msgstr "Choix personnalisé incorrect %(value)r pour « %(field)s »."

#: django_features/custom_fields/fields.py
#, python-format
msgid "Duplicate custom choice values are not allowed: %(values)s"
msgstr "Les valeurs de choix personnalisées en double ne sont pas autorisées : %(values)s"

#: django_features/custom_fields/fields.py
#, python-format
msgid "Some custom choices do not exist for '%(field)s': %(values)s"
msgstr "Certaines valeurs de choix personnalisées n’existent pas pour « %(field)s » : %(values)s"

#: django_features/custom_fields/fields.py
#, python-format
msgid "The field %(field)s is not a choice field."
msgstr "Le champ %(field)s n’est pas un champ de sélection."

#: django_features/custom_fields/fields.py
#, python-format
msgid "Expected a list of custom choices, but got %(value)r."
msgstr "Une liste de choix personnalisés était attendue, mais %(value)r a été reçu."

