#: django_features/custom_fields/fields.py
msgid "Für eine Mehrfachauswahl wird eine Liste erwartet, für eine Einfachauswahl ein einzelner Wert."
msgstr "Une liste est attendue pour une sélection multiple, ou une valeur unique pour une sélection simple."

#: django_features/custom_fields/fields.py
msgid "Ungültiger Suchwert für die Auswahl."
msgstr "Valeur de recherche de choix invalide."

#: django_features/custom_fields/fields.py
msgid "Eine ausgewählte Option existiert nicht in diesem Feld."
msgstr "Une option sélectionnée n'existe pas dans ce champ."

#: django_features/custom_fields/fields.py
msgid "Eine Option darf nur einmal ausgewählt werden."
msgstr "Une option ne peut être sélectionnée qu'une seule fois."

#: django_features/custom_fields/fields.py
msgid "Mehrere Optionen entsprechen dem Suchwert."
msgstr "Plusieurs options correspondent à la valeur recherchée."

#: django_features/custom_fields/fields.py
msgid "Diese Liste darf nicht leer sein."
msgstr "Cette liste ne peut pas être vide."

#: django_features/custom_fields/fields.py
msgid "Dieses Feld darf nicht leer sein."
msgstr "Ce champ ne peut pas être vide."

#: django_features/custom_fields/fields.py
msgid "Dieses Feld ist kein Auswahlfeld."
msgstr "Ce champ n'est pas un champ de sélection."

